# Copy this file to .env.local before running the app.
# .env.local is already gitignored — never commit real keys.

# Safe to expose to the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical deployed HTTPS URL. Used for safe links and social-preview metadata.
NEXT_PUBLIC_APP_URL=https://fincon.your-domain.com

# NEVER expose this to the browser. Server-side only (used in
# app/api/users/create/route.ts to create new Auth accounts). Get this
# from Supabase Dashboard -> Settings -> API -> service_role key.
# Do NOT paste it into chat with Claude or anywhere public.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# Resend is server-side only. Verify the sender domain in Resend before use.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=KCBL FinCon Suite <reports@your-verified-domain.com>

# Long random value used by the scheduled Vercel Cron request only.
CRON_SECRET=replace-with-a-long-random-secret
